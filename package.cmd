@echo off
rem Build and verify the standard/full Shroudtopia distributions in GitHub Actions.
cd /d "%~dp0"
if not "%GITHUB_ACTIONS%"=="true" (
    >&2 echo Distribution packages are generated by GitHub Actions. Use build.cmd for local development.
    exit /b 1
)
call "%~dp0build.cmd" || exit /b 1
pwsh -NoProfile -ExecutionPolicy Bypass -File "%~dp0scripts\package.ps1" || exit /b 1
